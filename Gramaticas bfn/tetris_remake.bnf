<programa> ::= <tipo_juego> <grid> <definiciones> <eventos>

<tipo_juego> ::= "GAME_TYPE" "TETRIS"
<grid>       ::= "GAME_GRID" "(" <numero> "," <numero> ")"
<eventos>    ::= <evento> | <evento> <eventos>

/* --- Definiciones: piezas normales y power-ups (en cualquier orden) --- */
<definiciones> ::= <definicion> | <definicion> <definiciones>
<definicion>   ::= <definicion_shape> | <definicion_powerup>

/* --- SHAPE: COLOR y CHANCE son OPCIONALES (retrocompatibilidad) --- */
<definicion_shape> ::= "DEFINE" "SHAPE" <identificador> ":" <atributos_shape> <estados> "END"
<atributos_shape>  ::= "" | <atributo_shape> <atributos_shape>
<atributo_shape>   ::= <atrib_color> | <atrib_chance>
<atrib_color>      ::= "COLOR" ":" <color_hex>
<atrib_chance>     ::= "CHANCE" ":" <numero>
<color_hex>        ::= "#" <hex> <hex> <hex> <hex> <hex> <hex>
<hex>              ::= <digito> | "A"..."F" | "a"..."f"

/* --- POWERUP: objeto especial con efecto y condiciones de aparicion --- */
<definicion_powerup> ::= "DEFINE" "POWERUP" <identificador> ":" <atributos_powerup> <estados> "END"
<atributos_powerup>  ::= "" | <atributo_powerup> <atributos_powerup>
<atributo_powerup>   ::= <atrib_color> | <atrib_efecto> | <atrib_puntos> | <trigger_lineas> | <trigger_rotar>
<atrib_efecto>       ::= "EFFECT" ":" <efecto>
<efecto>             ::= "CLEAR_ROW" | "FILL_COLUMN"
<atrib_puntos>       ::= "POINTS" ":" <numero>
<trigger_lineas>     ::= "TRIGGER_LINES" ":" <numero>
<trigger_rotar>      ::= "TRIGGER_ROTATE" ":" <identificador> <numero>

/* --- Estados y matrices (sin cambios) --- */
<estados>          ::= <estado> | <estado> <estados>
<estado>           ::= "STATE" <numero> ":" <matriz>
<matriz>           ::= <fila> | <fila> <matriz>
<fila>             ::= "[" <valores_fila> "]"
<valores_fila>     ::= <numero> | <numero> "," <valores_fila>

/* --- Eventos (sin cambios) --- */
<evento>         ::= "ON" <nombre_evento_tetris> ":" <acciones_tetris> "END"
<nombre_evento_tetris> ::= "START" | "TICK" | "LINE_CLEAR" | "KEY_UP" | "KEY_DOWN" | "KEY_LEFT" | "KEY_RIGHT"
<acciones_tetris>    ::= <accion_tetris> | <accion_tetris> <acciones_tetris>

<accion_tetris> ::= <accion_spawn> | <accion_mover> | <accion_rotar> | <accion_puntos>
<accion_spawn>  ::= "SPAWN" "RANDOM_SHAPE"
<accion_mover>  ::= "MOVE" "CURRENT_PIECE" <direccion>
<accion_rotar>  ::= "ROTATE" "CURRENT_PIECE"
<accion_puntos> ::= "INCREASE_SCORE" <numero>

<direccion>     ::= "LEFT" | "RIGHT" | "DOWN"
<identificador> ::= <letra> | <letra> <identificador>
<numero>        ::= <digito> | <digito> <numero>
<letra>         ::= "A"..."Z" | "_"
<digito>        ::= "0"..."9"
